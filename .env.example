# ── Email (Resend) ─────────────────────────────────────────────
# Optional. Without a key, the contact API runs in demo mode and
# returns a graceful success without sending anything.
RESEND_API_KEY=
# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=swalikhan885@gmail.com

# ── AI assistant ───────────────────────────────────────────────
# Optional. Without a key, the assistant answers from the local
# JSON knowledge base (config/*.json) using keyword matching.
OPENAI_API_KEY=

# ── Database (optional — contact persistence) ─────────────────
# Off by default. See README "Enabling the database" before use.
DATABASE_URL=

# ── Site ───────────────────────────────────────────────────────
# Public canonical URL, used for SEO, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
